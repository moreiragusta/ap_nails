// Configuração do Worker (API + site). Um projeto por cliente NUKKI.
// Para um novo cliente: troque "name", "database_name", "database_id", "bucket_name" e as vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ap-nails",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // O Worker roda antes de tudo para obrigar HTTPS também nas páginas
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ap-nails",
      // Id gerado em `wrangler d1 create ap-nails` (cada cliente tem o seu)
      "database_id": "60d30529-237e-4d95-8669-70d77ff1a28d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "ap-nails-photos" }
  ],
  "triggers": {
    // A cada 15 min: alerta de 3h, expiração de 48h e aviso de lembretes
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "BUSINESS_TZ": "America/Sao_Paulo",
    "VAPID_SUBJECT": "mailto:nukkitech@gmail.com",
    "VAPID_PUBLIC_KEY": "BGz_3uGmhGTIQwE5T1UEyd0Ee3pM2JgKc4QnUO62NZZ9WNaY7kX14rFKbIUL8YHf-pWYGLwre38o6iX0nIjPaFs",
    // Chave pública do Cloudflare Turnstile (antirrobô). Obrigatória em produção.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF-qtKZZ9w0nGqjI"
  }
  // Segredos (wrangler secret put): VAPID_PRIVATE_KEY, TURNSTILE_SECRET_KEY
}
